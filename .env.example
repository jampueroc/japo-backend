# Copy to .env and adjust. Everything is read from the environment (12-factor);
# nothing else in the codebase calls os.Getenv.
#
#   cp .env.example .env
#
# Do not quote the values: the Makefile loads this file with `include`, and
# docker compose reads it as well.

# --- Application ----------------------------------------------------------
APP_NAME=japo-api
# development | production
APP_ENV=development

# --- HTTP -----------------------------------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
# Max request body in bytes (512 KiB). Must stay above the 256 KiB progress
# document limit, so an oversized document is rejected with a descriptive 400
# instead of a bare 413.
HTTP_BODY_LIMIT=524288
# Max concurrent connections accepted by fasthttp. Small on purpose.
HTTP_CONCURRENCY=256
# Addresses allowed to set X-Forwarded-For, comma separated. REQUIRED behind
# the reverse proxy: without it every request looks like it comes from the
# proxy and the per IP rate limit becomes one global limit for everyone.
# Leave empty when the API is reached directly.
# HTTP_TRUSTED_PROXIES=127.0.0.1,::1

# --- Database -------------------------------------------------------------
# DB_HOST=localhost -> the API runs natively on the host (macOS development,
#                      `make dev`), talking to the MariaDB container through
#                      the port published by `make db-up`.
# DB_HOST=mariadb   -> the API runs inside docker compose (Raspberry Pi
#                      deploy) and reaches MariaDB by its service name.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=japo
DB_USER=japo
DB_PASSWORD=japo
# Root password for the MariaDB container only; the API never uses it.
MARIADB_ROOT_PASSWORD=root

# Connection pool, sized for a small box.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=2m
DB_DIAL_TIMEOUT=5s
DB_READ_TIMEOUT=10s
DB_WRITE_TIMEOUT=10s
# Boot time retries while MariaDB is still starting.
DB_CONNECT_RETRIES=10
DB_CONNECT_BACKOFF=2s
# Apply the embedded goose migrations on API startup.
DB_AUTO_MIGRATE=true

# --- Auth -----------------------------------------------------------------
# REQUIRED, at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=japo-api
# Access token lifetime. There are no refresh tokens by design.
JWT_TTL=1h
# bcrypt cost: 10 is roughly 100 ms on a Raspberry Pi 4.
BCRYPT_COST=10

# Email verification as a GATE. With this off (the default) verification is an
# extra that never blocks anyone: registering opens a session straight away.
# With it on, registering returns no token and the session only starts once
# the code is confirmed, so the gate is enforced by never issuing a credential
# rather than by trusting the client.
AUTH_REQUIRE_VERIFIED_EMAIL=false
AUTH_VERIFICATION_CODE_TTL=15m
# A six digit code is only a million possibilities: this is what bounds
# guessing it.
AUTH_MAX_VERIFICATION_ATTEMPTS=5
AUTH_RESET_TOKEN_TTL=1h

# --- Email ----------------------------------------------------------------
# log  -> writes the message to the log instead of sending it. The development
#         default: no SMTP server needed and the verification code shows up
#         right in the terminal.
# smtp -> sends for real.
MAIL_DRIVER=log
MAIL_FROM=japo-api@localhost
MAIL_TIMEOUT=10s
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# starttls (port 587) | tls (port 465) | none (a relay on localhost)
# SMTP_TLS=starttls

# Public base URL of the web client and the route that handles a reset link.
# Together they build the URL emailed by /auth/forgot-password.
APP_PUBLIC_URL=http://localhost:4400
APP_RESET_PATH=/reset-password

# --- CORS -----------------------------------------------------------------
# The Nihongo Angular dev server. Only matters when the browser hits this API
# directly: in the normal flow the client is served behind a reverse proxy and
# shares its origin, so CORS never participates. Comma separated list, and
# never leave "*" in production.
CORS_ALLOW_ORIGINS=http://localhost:4400
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_ALLOW_CREDENTIALS=false

# --- Rate limiting --------------------------------------------------------
# In-memory sliding windows, which is the right store for a single instance.
# The login bucket matters most: bcrypt is expensive on purpose, so an
# unthrottled login endpoint is both a brute force and a denial of service.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=15m
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW=1h
# Applies to every endpoint that makes the server send an email, and is keyed
# by destination as well as by IP so nobody's inbox can be flooded.
RATE_LIMIT_EMAIL_MAX=5
RATE_LIMIT_EMAIL_WINDOW=1h

# --- Logging --------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# json (production) | text (nicer while developing)
LOG_FORMAT=text

# --- Docker compose only --------------------------------------------------
# Host port the api container publishes.
API_PORT=8080
# Image built by `make docker-build`.
API_IMAGE=japo-api
API_TAG=latest
# Architecture of the deploy image: arm64 for the Raspberry Pi.
TARGETARCH=arm64
