# MariaDB tuning for a small box (Raspberry Pi, 2-4 GB of RAM).
# Mounted read-only into /etc/mysql/conf.d by docker-compose.
[mariadb]

# --- Memory --------------------------------------------------------------
# The single biggest RAM consumer. 128M holds this dataset comfortably while
# leaving room for the API and the OS.
innodb_buffer_pool_size         = 128M
innodb_buffer_pool_instances    = 1
innodb_log_file_size            = 64M
# Per connection buffers: keep them small, this API runs few, short queries.
sort_buffer_size                = 512K
read_buffer_size                = 256K
read_rnd_buffer_size            = 256K
join_buffer_size                = 512K
tmp_table_size                  = 16M
max_heap_table_size             = 16M
table_open_cache                = 256
thread_cache_size               = 8
# performance_schema alone costs well over 100 MB. Not worth it here.
performance_schema              = OFF

# --- Connections ---------------------------------------------------------
# The API pool is capped at DB_MAX_OPEN_CONNS (10); this leaves headroom for
# a mysql client and the healthcheck.
max_connections                 = 30
# No reverse DNS lookups on connect: faster and one less failure mode.
skip-name-resolve

# --- Durability / SD card wear ------------------------------------------
# 2 = flush the redo log once per second instead of on every commit. A crash
# can lose up to one second of writes, which is acceptable for this data and
# much kinder to the storage.
innodb_flush_log_at_trx_commit  = 2
innodb_flush_method             = O_DIRECT
innodb_file_per_table           = ON

# --- Charset -------------------------------------------------------------
character-set-server            = utf8mb4
collation-server                = utf8mb4_unicode_ci

# --- Logging -------------------------------------------------------------
slow_query_log                  = ON
long_query_time                 = 1
